# Create these secret files outside the repository or supply the environment variables directly.
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram
OPENCODE_API_KEY_FILE=/run/secrets/opencode
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=claude-haiku-5-5
# Used only when Go rejects the primary model due to account region settings.
OPENCODE_FALLBACK_MODEL=gpt-6-luna
WHISPER_MODEL=small
# Public hostname with DNS pointing to your server.
ALEPH_DOMAIN=aleph.example.com
